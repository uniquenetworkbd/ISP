APP_NAME=ISP NOC Backend
APP_VERSION=1.0.0
APP_ENV=production
POSTGRES_USER=isp
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=isp
DATABASE_URL=postgresql+psycopg://isp:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/isp
ALLOWED_ORIGINS='["https://uniquenetworkbd.github.io"]'
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
MONITORING_INTERVAL_SECONDS=60
MIKROTIK_CONNECT_TIMEOUT=10
MIKROTIK_VERIFY_TLS=true
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_REAL_FERNET_KEY
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
