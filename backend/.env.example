APP_NAME=ISP NOC Backend
APP_VERSION=0.1.0
APP_ENV=development # set to production only after replacing every placeholder below
POSTGRES_USER=isp
POSTGRES_PASSWORD=replace-with-a-long-db-password-123456
POSTGRES_DB=isp
DATABASE_URL=postgresql+psycopg://isp:replace-with-a-long-db-password-123456@postgres:5432/isp
ALLOWED_ORIGINS='["http://localhost:8000","http://localhost:5173","https://uniquenetworkbd.github.io"]'
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
MONITORING_INTERVAL_SECONDS=60
MIKROTIK_CONNECT_TIMEOUT=10
MIKROTIK_VERIFY_TLS=true
# Required for saving MikroTik credentials through the management API.
# Generate a Fernet key and keep it outside source control.
CREDENTIAL_ENCRYPTION_KEY=GENERATE_A_REAL_FERNET_KEY_BEFORE_STARTUP

# Optional one-time administrator bootstrap (set only on the backend host, never commit real values).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
