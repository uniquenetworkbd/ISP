APP_NAME=ISP NOC Backend
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://isp:isp@localhost:5432/isp
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,https://uniquenetworkbd.github.io
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
MONITORING_INTERVAL_SECONDS=60
MIKROTIK_CONNECT_TIMEOUT=10
MIKROTIK_VERIFY_TLS=true
